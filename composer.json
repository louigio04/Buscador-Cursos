{
    "name": "louigio04/buscador-cursos",
    "description": "Projeto que busca os cursos no site da Alura",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "louigio04\\BuscadorDeCursos\\": "src/"
        }
    },
    "authors": [
        {
            "name": "louigio04",
            "email": "luiginmen638@gmail.com"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^8.3",
        "symfony/dom-crawler": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "*",
        "phan/phan": "^6.0"
    },
    "scripts": {
        "test": "phpunit tests\\TestBuscadorDeCursos.php",
        "cs": "phpcs --standard=PSR12 src/",
        "phan": "phan",
        "exibe-cursos": "louigio04\\BuscadorDeCursos:",
        "check": [
            "@phan",
            "@cs",
            "@test"
        ],
        "post-update-cmd": [
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "Roda as verificações do código. PHAN, PHPCS e PHPUNIT"
    }
}
